<!--    Instead of running everything, can run seperate only what is ready.-->
    <profiles>
        <profile>
            <id>ui</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <includes>
                                <include>**/ui/**/*.java</include>
                                <include>**/pageObjects/**/*.java</include>
                                <include>**/stepDefinitions/**/*.java</include>
                                <include>**/runner/**/*.java</include>
                            </includes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>api</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <includes>
                                <include>**/api/**/*.java</include>
                            </includes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>db</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <includes>
                                <include>**/dbTests/**/*.java</include>
                            </includes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>micro</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <includes>
                                <include>**/microservice/**/*.java</include>
                            </includes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>performance</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.lazerycode.jmeter</groupId>
                        <artifactId>jmeter-maven-plugin</artifactId>
                        <version>3.7.0</version>
                        <executions>
                            <execution>
                                <id>run-jmeter-tests</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>jmeter</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>







    <build>
        <!-- REGISTER JMX FOLDER AS TEST RESOURCES -->
        <testResources>
            <!-- Keep default test resources -->
            <testResource>
                <directory>src/test/resources</directory>
            </testResource>

            <!-- Add JMeter folder -->
            <testResource>
                <directory>src/test/jmeter</directory>
                <includes>
                    <include>*.jmx</include>
                </includes>
            </testResource>
        </testResources>

        <plugins>
            <!-- Allure Maven Plugin -->
            <plugin>
                <groupId>io.qameta.allure</groupId>
                <artifactId>allure-maven</artifactId>
                <version>2.11.2</version>
                <configuration>
                    <resultsDirectory>reports/api/allure-results</resultsDirectory>
                    <reportDirectory>reports/api/allure-report</reportDirectory>
                </configuration>
                <executions>
                    <execution>
                        <phase>post-integration-test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Surefire Plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <skip>${surefire.skip}</skip>
                    <testSourceDirectory>src/test/java</testSourceDirectory>
                    <systemPropertyVariables>
                        <allure.results.directory>reports/api/allure-results</allure.results.directory>
                    </systemPropertyVariables>
                </configuration>
            </plugin>

            <!-- JMeter Plugin -->
            <plugin>
                <groupId>com.lazerycode.jmeter</groupId>
                <artifactId>jmeter-maven-plugin</artifactId>
                <version>3.7.0</version>

                <executions>
                    <execution>
                        <id>configuration</id>
                        <phase>generate-test-resources</phase>
                        <goals>
                            <goal>configure</goal>
                        </goals>
                    </execution>

                    <execution>
                        <id>run-jmeter-tests</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>jmeter</goal>
                        </goals>
                    </execution>
                </executions>

                <configuration>
                    <jmeterExtensions>
                        <artifact>kg.apc:jmeter-plugins-casutg:2.10</artifact>
                        <artifact>kg.apc:jmeter-plugins-manager:1.11</artifact>
                    </jmeterExtensions>

                    <testFilesDirectory>src/test/jmeter/</testFilesDirectory>

                    <testFilesIncluded>
<!--                        <jMeterTestFile>spike-test.jmx</jMeterTestFile>-->
<!--                        <jMeterTestFile>load-test.jmx</jMeterTestFile>-->
<!--                        <jMeterTestFile>stress-test.jmx</jMeterTestFile>-->
<!--                        <jMeterTestFile>endurance-test.jmx</jMeterTestFile>-->
<!--                        <jMeterTestFile>scalability-test.jmx</jMeterTestFile>-->
                    </testFilesIncluded>

                    <resultsDirectory>target/reports/performance/results</resultsDirectory>
                    <generateReports>true</generateReports>

                    <propertiesUser>
                        <!-- Core CSV format -->
                        <property>
                            <name>jmeter.save.saveservice.output_format</name>
                            <value>csv</value>
                        </property>
                        <property>
                            <name>jmeter.save.saveservice.print_field_names</name>
                            <value>true</value>
                        </property>
                        <property>
                            <name>jmeter.save.saveservice.autoflush</name>
                            <value>true</value>
                        </property>

                        <!-- Required fields for HTML Dashboard -->
                        <property><name>jmeter.save.saveservice.timeStamp</name><value>true</value></property>
                        <property><name>jmeter.save.saveservice.elapsed</name><value>true</value></property>
                        <property><name>jmeter.save.saveservice.label</name><value>true</value></property>
                        <property><name>jmeter.save.saveservice.responseCode</name><value>true</value></property>
                        <property><name>jmeter.save.saveservice.threadName</name><value>true</value></property>
                        <property><name>jmeter.save.saveservice.success</name><value>true</value></property>
                        <property><name>jmeter.save.saveservice.bytes</name><value>true</value></property>
                        <property><name>jmeter.save.saveservice.sentBytes</name><value>true</value></property>
                        <property><name>jmeter.save.saveservice.grpThreads</name><value>true</value></property>
                        <property><name>jmeter.save.saveservice.allThreads</name><value>true</value></property>
                        <property><name>jmeter.save.saveservice.latency</name><value>true</value></property>
                        <property><name>jmeter.save.saveservice.idleTime</name><value>true</value></property>
                        <property><name>jmeter.save.saveservice.connect</name><value>true</value></property>

                        <!-- Disable fields that cause corrupted CSV rows -->
                        <property><name>jmeter.save.saveservice.response_message</name><value>false</value></property>
                        <property><name>jmeter.save.saveservice.data_type</name><value>false</value></property>
                        <property><name>jmeter.save.saveservice.url</name><value>false</value></property>
                        <property><name>jmeter.save.saveservice.samplerData</name><value>false</value></property>
                        <property><name>jmeter.save.saveservice.response_data</name><value>false</value></property>
                        <property><name>jmeter.save.saveservice.assertion_results</name><value>none</value></property>
                    </propertiesUser>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>copy-jmeter-html-report</id>
                        <phase>install</phase>
                        <configuration>
                            <target>
                                <!-- Create correct destination folder -->
                                <mkdir dir="reports/performance/spike-test/html"/>
                                <!-- Copy HTML report into spike-test/html -->
                                <copy todir="reports/performance/spike-test/html" overwrite="true">
                                    <fileset dir="target/jmeter/reports/spike-test"/>
                                </copy>

                                <mkdir dir="reports/performance/load-test/html"/>
                                <copy todir="reports/performance/load-test/html" overwrite="true">
                                    <fileset dir="target/jmeter/reports/load-test"/>
                                </copy>

                                <mkdir dir="reports/performance/stress-test/html"/>
                                <copy todir="reports/performance/stress-test/html" overwrite="true">
                                    <fileset dir="target/jmeter/reports/stress-test"/>
                                </copy>

                                <mkdir dir="reports/performance/endurance-test/html"/>
                                <copy todir="reports/performance/endurance-test/html" overwrite="true">
                                    <fileset dir="target/jmeter/reports/endurance-test"/>
                                </copy>

                                <mkdir dir="reports/performance/scalability-test/html"/>
                                <copy todir="reports/performance/scalability-test/html" overwrite="true">
                                    <fileset dir="target/jmeter/reports/scalability-test"/>
                                </copy>
                            </target>
                        </configuration>
                        <goals>
                            <goal>run</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

        </plugins>

    </build>


</project>
